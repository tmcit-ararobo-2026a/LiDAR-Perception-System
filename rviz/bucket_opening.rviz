Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /PointCloud2 (Livox)1
        - /Bucket Opening1
      Splitter Ratio: 0.5
    Tree Height: 600
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 1
      Plane Cell Count: 10
      Color: 100; 100; 100
      Alpha: 0.4
      Reference Frame: map
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: PointCloud2 (Livox)
      Topic:
        Value: /livox/lidar
        Depth: 5
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Min Color: 30; 100; 255
      Max Color: 255; 220; 40
      Decay Time: 0
      Queue Size: 30
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Bucket Opening
      Topic:
        Value: /bucket_opening_tracker/markers
        Depth: 10
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Queue Size: 10
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Selected Robot
      Topic:
        Value: /bucket_opening_tracker/selected_cloud
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 2
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 100; 180; 255
      Decay Time: 0.3
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Accumulated Robot
      Topic:
        Value: /bucket_opening_tracker/accumulated_cloud
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 2
      Style: Points
      Size (Pixels): 4
      Color Transformer: FlatColor
      Color: 255; 180; 70
      Decay Time: 0.3
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Opponent Frame
      Topic:
        Value: /bucket_opening_tracker/robot_markers
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 2
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Bucket Bottom (observed)
      Topic:
        Value: /bucket_opening_tracker/bottom_markers
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 2
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Bucket Bottom Plane
      Topic:
        Value: /bucket_opening_tracker/bottom_cloud
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 2
      Style: Points
      Size (Pixels): 5
      Color Transformer: FlatColor
      Color: 255; 140; 0
      Decay Time: 0.3
    - Class: rviz_default_plugins/TF
      Enabled: false
      Name: TF (optional)
      Show Arrows: true
      Show Axes: true
      Show Names: false
  Enabled: true
  Global Options:
    Background Color: 25; 25; 35
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Target Frame: map
      Distance: 13
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 1.3
      Yaw: 0.5
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
